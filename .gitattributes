# Consistent source line endings across Windows and Linux
* text=auto
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.param text eol=lf
*.xml text eol=lf
*.msg text eol=lf
*.srv text eol=lf
*.action text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary design, document and media files must not be line-normalized or merged
*.SchDoc binary
*.PcbDoc binary
*.SchLib binary
*.PcbLib binary
*.IntLib binary
*.STEP binary
*.step binary
*.stl binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.mov binary
*.MOV binary
*.zip binary

# Git LFS is intentionally not activated by default.
# See docs/repository/data-and-large-files.md before adding large assets.
